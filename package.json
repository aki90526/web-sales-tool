{
  "name": "web-sales-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Web production sales support tool",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:sheets": "ts-node src/scripts/testSheetsConnection.ts",
    "collect": "ts-node src/scripts/collectLeads.ts",
    "collect:import": "ts-node src/scripts/importPreviewLeads.ts",
    "forms:assist": "ts-node src/scripts/assistFormSubmission.ts",
    "forms:todo": "ts-node src/scripts/listFormSubmissions.ts",
